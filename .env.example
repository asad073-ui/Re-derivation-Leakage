# Detector v4.2 model judges — credentials.
#
# Copy to `.env` and fill in. `.env` is gitignored (`*.env` and `.env`), and no v4.2
# command ever writes a key into a manifest, an artifact or a log. Keys are read from the
# ENVIRONMENT only; none of them is accepted as a command-line argument, because an
# argument lands in shell history and in `ps`.
#
#   bash / zsh:   set -a; . ./.env; set +a
#   PowerShell:   Get-Content .env | % { if ($_ -match '^\s*([A-Z_]+)=(.*)$') { [Environment]::SetEnvironmentVariable($Matches[1], $Matches[2]) } }
#
# Neither key is needed for `make cpu-all`. Every offline command — `judge-plan`,
# `freeze-banks`, `build-bank`, `bank-audit`, and `llm-judge --dry-run` — runs without
# them, which is why the CPU gate stays free and offline.

# Judge A — Google Gemini API, model `gemini-3.7-flash`, free tier.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Judge B — Groq, model `openai/gpt-oss-120b`, free plan.
# https://console.groq.com/keys
GROQ_API_KEY=

# Not used by the frozen v4.2 roster. Present because `PROVIDERS` still carries the
# adapters, and a future protocol revision that names a paid judge would need them — such
# a revision must be recorded in DECISIONS.md BEFORE the first call, never after a kappa.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
