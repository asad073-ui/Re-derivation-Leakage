# Copy to .env (which is gitignored) or set these in your shell.
# On Colab these come from Colab Secrets, NOT from a file. Never commit real values.

# HF account that has ACCEPTED the Llama 3.2 community license.
# Without the acceptance, every TOFU checkpoint pull 401s.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Keep the HF cache off Google Drive on Colab: Drive I/O is slow and these repos are GBs.
HF_HOME=/content/hf

# Fine-grained PAT, scoped to THIS repository only, Contents: Read and write.
GH_PAT=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

TOKENIZERS_PARALLELISM=false
